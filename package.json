{
	"name": "workforce-workspace",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Management and fleet library for Cloudflare Workers",
	"workspaces": [
		"core",
		"action"
	],
	"scripts": {
		"typecheck": "bun run --cwd core typecheck && bun run --cwd core build && bun run --cwd action typecheck",
		"test": "bun run --cwd core test && bun run --cwd action test",
		"test:unit": "bun run --cwd core test:unit",
		"test:e2e": "bun run --cwd core test:e2e",
		"test:e2e:integration": "bun run --cwd core test:e2e:integration",
		"test:coverage": "bun run --cwd core test:coverage",
		"build": "bun run --cwd core build && bun run --cwd action build",
		"docs:build": "typedoc",
		"docs:serve": "typedoc --watch",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"prepare": "husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-sh": "^0.19.0",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3"
	},
	"author": "Gregory Mitchell <me@gmitch215.xyz>",
	"homepage": "https://github.com/drupflare/workforce",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drupflare/workforce.git"
	},
	"bugs": {
		"url": "https://github.com/drupflare/workforce/issues"
	},
	"lint-staged": {
		"*.{ts,js,mjs,css,md,json,jsonc,yml,yaml,sh}": "prettier --write"
	}
}
