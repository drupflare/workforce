{
	"name": "@drupflare/workforce",
	"version": "0.2.0",
	"type": "module",
	"description": "Management and fleet library for Cloudflare Workers",
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./store": {
			"types": "./dist/store/index.d.ts",
			"import": "./dist/store/index.js"
		},
		"./merge": {
			"types": "./dist/revisions/merge.d.ts",
			"import": "./dist/revisions/merge.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "bun run build.ts && bun run verify:dist",
		"verify:dist": "node scripts/check-dist.mjs",
		"prepack": "cp ../LICENSE ./LICENSE && cp ../README.md ./README.md",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
		"test": "vitest run --project=unit",
		"test:unit": "vitest run --project=unit",
		"test:unit:watch": "vitest --project=unit",
		"test:coverage": "vitest run --project=unit --coverage",
		"test:e2e": "vitest run --project=e2e",
		"test:e2e:integration": "WORKFORCE_E2E_INTEGRATION=1 vitest run --project=e2e",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check ."
	},
	"dependencies": {
		"node-diff3": "^3.2.1"
	},
	"peerDependencies": {
		"edgeport": "^1.0.6"
	},
	"peerDependenciesMeta": {
		"edgeport": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260811.1",
		"@drupflare/untarl": "^0.1.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^4.1.0",
		"edgeport": "^1.0.6",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0",
		"wrangler": "^4.123.0"
	},
	"author": "Gregory Mitchell <me@gmitch215.xyz>",
	"homepage": "https://github.com/drupflare/workforce",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drupflare/workforce.git",
		"directory": "core"
	},
	"bugs": {
		"url": "https://github.com/drupflare/workforce/issues"
	},
	"keywords": [
		"cloudflare",
		"workers",
		"workerd",
		"fleet",
		"deploy",
		"workers-for-platforms",
		"edge"
	]
}
