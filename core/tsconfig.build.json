{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["@cloudflare/workers-types", "node"],
		"paths": {
			"@drupflare/untarl": ["./types/untarl.d.ts"]
		},
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "src",
		"outDir": "dist",
		"verbatimModuleSyntax": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules", "coverage", "tests", "**/*.spec.ts"]
}
